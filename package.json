{
  "name": "editor",
  "version": "0.1.0",
  "private": true,
  "description": "A small desktop video editor.",
  "author": "sankalpaacharya",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder",
    "dist:linux": "pnpm build && electron-builder --linux AppImage",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "release": "pnpm build && electron-builder --publish always"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "^3.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
